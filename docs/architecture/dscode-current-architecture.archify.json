  "cards": [
    {
      "dot": "cyan",
      "title": "主执行链",
      "items": [
        "TUI 与 Web 只依赖 HarnessAPI，不接触内部 Manager",
        "Application 负责编排 Session、Project、MCP 与 Agent 生命周期",
        "Main Agent 与 SubAgent 都通过 Pi Agent Runtime 执行"
      ]
    },
    {
      "dot": "violet",
      "title": "所有权规则",
      "items": [
        "src/application 是跨模块控制面，src/kernel 仅保留基础原语",
        "Agent Definitions 与 Agent Process 分离：前者描述，后者执行",
        "Skills 与 MCP 可同属能力视图，但源码所有权和生命周期独立"
      ]
    },
    {
      "dot": "emerald",
      "title": "状态与 I/O",
      "items": [
        "Session、Process Snapshot 与文件 Checkpoint 具有不同恢复粒度",
        "Skill 只注入指令并选择 Tool，Driver 才连接具体资源",
        "MCP Manager 通过动态 Driver 向 ToolRegistry 贡献远程能力"
      ]
    }
  ]
