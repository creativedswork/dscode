[
  {
    "name": "Presentation may consume the Application facade",
    "from": "src/ui/tui-backend.ts",
    "to": "src/core/harness-api.ts",
    "rules": []
  },
  {
    "name": "Presentation may implement an owner-defined interaction contract",
    "from": "src/ui/backend.ts",
    "to": "src/permissions/types.ts",
    "rules": []
  },
  {
    "name": "Runtime must not consume a Presentation projector",
    "from": "src/agents/runtimes/pi-agent-runtime.ts",
    "to": "src/ui/shared/tool-result-projection.ts",
    "rules": ["no-presentation-dependency"]
  },
  {
    "name": "Presentation must not consume a concrete Manager",
    "from": "src/ui/web/web-backend.ts",
    "to": "src/session/manager.ts",
    "rules": ["presentation-uses-application-ports"]
  },
  {
    "name": "Application must use an Integration port",
    "from": "src/core/harness.ts",
    "to": "src/integrations/registry.ts",
    "rules": ["application-uses-owner-ports"]
  },
  {
    "name": "Non-designated bootstrap modules are not composition roots",
    "from": "src/bootstrap/helpers.ts",
    "to": "src/ui/tui-backend.ts",
    "rules": ["composition-root-exact-files", "no-presentation-dependency"]
  },
  {
    "name": "The temporary CLI Composition Root may wire concrete adapters",
    "from": "src/core/main.ts",
    "to": "src/integrations/open-design/index.ts",
    "rules": []
  },
  {
    "name": "Driver contracts come from their owner",
    "from": "src/drivers/registry.ts",
    "to": "src/core/types.ts",
    "rules": ["no-core-type-bag"]
  },
  {
    "name": "Infrastructure uses Kernel Execution Context",
    "from": "src/drivers/fs.ts",
    "to": "src/agents/process/context.ts",
    "rules": ["infrastructure-uses-kernel-context"]
  }
]
