{
  "name": "@wangcan26/dscode",
  "version": "0.1.5",
  "type": "module",
  "description": "DeepSeek-native terminal AI agent for digital work — DeepSeek model harness analogous to Claude Code for Claude models.",
  "bin": {
    "dscode": "dist/dscode.mjs"
  },
  "main": "dist/dscode.mjs",
  "files": [
    "dist/",
    "dist/web/",
    "docs/assets/",
    "docs/screen_shots/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/core/main.ts",
    "build": "node scripts/build.mjs",
    "build:web": "cd web && npm run build",
    "ci:check": "npm run lockfile:check && rm -rf dist node_modules web/node_modules && npm ci && cd web && npm install && cd .. && npm run build && echo \"\n✅ CI check passed\"",
    "dev:web": "tsx src/core/main.ts --web & cd web && npm run dev",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lockfile:check": "node scripts/lockfile-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangcan26/dscode.git"
  },
  "keywords": [
    "deepseek",
    "ai",
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "code-assistant"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.74.0",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "chalk": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  }
}
